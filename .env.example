# ─────────────────────────────────────────────────────────────
# Job Scraper — Environment Configuration
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────────────────

# ── Storage ───────────────────────────────────────────────────
# Leave DATABASE_URL empty to run without a database: "already sent" state is
# kept in STORE_FILE. Set it to use PostgreSQL (Docker Compose, GitHub Actions).
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=disable
# DATABASE_URL=postgres://postgres:yourpassword@localhost:5432/jobscraper?sslmode=disable
STORE_FILE=.data/seen.json
# The first run on an empty store only records jobs (no flood of messages).
# Set to true to send that first run's jobs too.
NOTIFY_FIRST_RUN=false

# ── Telegram Bot ──────────────────────────────────────────────
# 1. Open @BotFather in Telegram
# 2. Send /newbot — follow prompts to get your BOT_TOKEN
# 3. Send a message to your bot, then visit:
#    https://api.telegram.org/bot<TOKEN>/getUpdates
#    to find your CHAT_ID (look for "chat":{"id": ...})
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_CHAT_ID=-1001234567890

# ── Feeds ─────────────────────────────────────────────────────
# Job feeds are defined in profiles.yaml, career pages in companies.yaml.
PROFILES_FILE=profiles.yaml
COMPANIES_FILE=companies.yaml

# Only used when profiles.yaml is missing (legacy single feed)
KEYWORDS=frontend developer,backend developer,fullstack developer
LOCATIONS=Mumbai,Bangalore,Hyderabad,Delhi,Pune

# ── Scraping Behavior ─────────────────────────────────────────
MAX_PAGES=3
MIN_DELAY_SECONDS=1
MAX_DELAY_SECONDS=3
MAX_RETRIES=3
# Max browser/search tasks running at once
MAX_CONCURRENCY=4

# ── Scheduler ─────────────────────────────────────────────────
# Standard 5-field cron: minute hour day month weekday
# (only used when not in RUN_ONCE mode)
# "0 * * * *"  = every hour at :00
# "0 */2 * * *" = every 2 hours
CRON_SCHEDULE=0 * * * *

# ── Notifications ─────────────────────────────────────────────
# Print Telegram messages to the console instead of sending them
# (read-only: nothing is saved, so the jobs are still sent by the next real run)
DRY_RUN=false