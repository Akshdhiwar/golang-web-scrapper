# ─────────────────────────────────────────────────────────────
# Job Scraper — Environment Configuration
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=disable
DATABASE_URL=postgres://postgres:yourpassword@localhost:5432/jobscraper?sslmode=disable

# ── Telegram Bot ──────────────────────────────────────────────
# 1. Open @BotFather in Telegram
# 2. Send /newbot — follow prompts to get your BOT_TOKEN
# 3. Send a message to your bot, then visit:
#    https://api.telegram.org/bot<TOKEN>/getUpdates
#    to find your CHAT_ID (look for "chat":{"id": ...})
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_CHAT_ID=-1001234567890

# ── Scraping Targets ──────────────────────────────────────────
KEYWORDS=frontend developer,backend developer,fullstack developer
LOCATIONS=Mumbai,Bangalore,Hyderabad,Delhi,Pune

# ── Scraping Behavior ─────────────────────────────────────────
MAX_PAGES=3
MIN_DELAY_SECONDS=1
MAX_DELAY_SECONDS=3
MAX_RETRIES=3

# ── Scheduler ─────────────────────────────────────────────────
# Cron format: second minute hour day month weekday
# "0 * * * *"  = every hour at :00
# "0 */2 * * *" = every 2 hours
CRON_SCHEDULE=0 * * * *

# ── Notifications ─────────────────────────────────────────────
# How many jobs to bundle per Telegram message (avoid flooding)
NOTIFICATION_BATCH_SIZE=10


curl -X POST \
"https://api.telegram.org/bot8581111247:AAGUMyH6ds0WpBwOKyoz9oFc1R2BCWI-XpI/sendMessage" \
-H "Content-Type: application/json" \
-d '{"chat_id":"6610033198","text":"Bot is working!"}'